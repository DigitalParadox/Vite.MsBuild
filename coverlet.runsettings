<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[*.Tests]*,[*.PureUnitTests]*,[*.E2ETests]*</Exclude>
          <ExcludeByFile>**/obj/**,**/bin/**</ExcludeByFile>
          <Include>[ViteKit.MsBuild.Tasks]*</Include>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
