<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>ViteKit.MsBuild</id>
    <version>1.0.0-test</version>
    <authors>DigitalParadox</authors>
    <owners>DigitalParadox</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/DigitalParadox/ViteKit.MsBuild</projectUrl>
    <description>Framework-agnostic MSBuild integration for Vite in ASP.NET Core projects. Supports Vue, React, Svelte, Solid, Preact, and vanilla JS/TS with zero configuration.</description>
    <releaseNotes>Initial release with full Vite integration support.</releaseNotes>
    <copyright>Copyright © 2025 DigitalParadox</copyright>
    <tags>vite msbuild aspnetcore vue react svelte solid frontend bundler typescript javascript</tags>
    <readme>README.md</readme>
    <repository type="git" url="https://github.com/DigitalParadox/ViteKit.MsBuild" />
    <dependencies>
      <group targetFramework="net8.0" />
      <group targetFramework="net9.0" />
      <group targetFramework="net10.0" />
    </dependencies>
  </metadata>
  <files>
    <!-- MSBuild integration files -->
    <file src="build\ViteKit.MsBuild.props" target="build" />
    <file src="build\ViteKit.MsBuild.targets" target="build" />
    
    <!-- Documentation -->
    <file src="README.md" target="" />
  </files>
</package>
