<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>ViteKit.MsBuild</id>
    <!-- Version overridden at pack time via -p:Version -->
    <version>0.0.0-placeholder</version>
    <authors>DigitalParadox</authors>
    <owners>DigitalParadox</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/DigitalParadox/ViteKit</projectUrl>
    <description>Framework-agnostic MSBuild integration for Vite in ASP.NET Core projects. Supports Vue, React, Svelte, Solid, Preact, and vanilla JS/TS with zero configuration.</description>
    <releaseNotes>See GitHub Releases for auto-generated notes.</releaseNotes>
    <copyright>Copyright © 2025 DigitalParadox</copyright>
    <tags>vite msbuild aspnetcore vue react svelte solid frontend bundler typescript javascript</tags>
    <readme>README.md</readme>
    <repository type="git" url="https://github.com/DigitalParadox/ViteKit" />
    <dependencies>
      <group targetFramework="net8.0" />
      <group targetFramework="net9.0" />
      <group targetFramework="net10.0" />
    </dependencies>
  </metadata>
  <files>
    <!-- MSBuild integration files -->
    <file src="build\ViteKit.MsBuild.props" target="build" />
    <file src="build\ViteKit.MsBuild.targets" target="build" />

    <!-- Tasks assembly (highest TFM) placed in build for direct resolution -->
    <file src="src\ViteKit.MsBuild.Tasks\bin\Release\net8.0\ViteKit.MsBuild.Tasks.dll" target="build" />
    <!-- Optional multi-TFM fallback locations -->
    <file src="src\ViteKit.MsBuild.Tasks\bin\Release\net8.0\ViteKit.MsBuild.Tasks.dll" target="tasks\net8.0" />
    <file src="src\ViteKit.MsBuild.Tasks\bin\Release\net9.0\ViteKit.MsBuild.Tasks.dll" target="tasks\net9.0" />
    <file src="src\ViteKit.MsBuild.Tasks\bin\Release\net10.0\ViteKit.MsBuild.Tasks.dll" target="tasks\net10.0" />

    <!-- Documentation -->
    <file src="README.md" target="" />
  </files>
</package>
