<!-- 
Working Directory Examples for Vite.MsBuild CustomCommand
Shows different ways to set working directories for command execution
-->

<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <!-- ========================================================================
       OPTION 1: Built into Command (Cross-Platform)
       ======================================================================== -->

  <!-- PowerShell with working directory change -->
  <DefineViteConfig 
      Name="frontend-build"
      Config="frontend/vite.config.ts"
      CustomCommand="powershell -Command &quot;cd frontend; npm run build&quot;"
      Mode="production"
      Condition="$([MSBuild]::IsOSPlatform('Windows'))" />

  <!-- Shell with working directory change -->
  <DefineViteConfig 
      Name="frontend-build"
      Config="frontend/vite.config.ts"
      CustomCommand="sh -c &quot;cd frontend &amp;&amp; npm run build&quot;"
      Mode="production"
      Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />

  <!-- ========================================================================
       OPTION 2: Multiple Directory Operations
       ======================================================================== -->

  <!-- Build multiple subdirectories -->
  <DefineViteConfig 
      Name="multi-dir-build"
      CustomCommand="powershell -Command &quot;cd apps/admin; npm run build; cd ../customer; npm run build; cd ../..&quot;"
      Mode="production" />

  <!-- Or using batch style -->
  <DefineViteConfig 
      Name="multi-dir-batch"
      CustomCommand="cmd /c &quot;cd apps\admin &amp;&amp; npm run build &amp;&amp; cd ..\customer &amp;&amp; npm run build&quot;"
      Mode="production" />

  <!-- ========================================================================
       OPTION 3: Using MSBuild Properties for Paths
       ======================================================================== -->

  <!-- Define relative paths -->
  <PropertyGroup>
    <FrontendPath>$(MSBuildProjectDirectory)\frontend</FrontendPath>
    <BackendPath>$(MSBuildProjectDirectory)\backend</BackendPath>
  </PropertyGroup>

  <!-- Use computed paths in commands -->
  <DefineViteConfig 
      Name="path-aware-build"
      CustomCommand="powershell -Command &quot;cd '$(FrontendPath)'; npm ci; npm run build&quot;"
      Mode="production" />

  <!-- ========================================================================
       OPTION 4: Complex Directory-Aware Commands
       ======================================================================== -->

  <!-- Ensure directory exists then run command -->
  <DefineViteConfig 
      Name="safe-directory-build"
      CustomCommand="powershell -Command &quot;if (-not (Test-Path 'apps/client')) { throw 'Client directory not found' }; cd apps/client; npm install; npm run build&quot;"
      Mode="production" />

  <!-- Run different commands in different directories -->
  <DefineViteConfig 
      Name="workspace-build"
      CustomCommand="powershell -Command &quot;cd packages/ui; npm run build; cd ../utils; npm run build; cd ../app; npm run build&quot;"
      Mode="production" />

  <!-- ========================================================================
       OPTION 5: Using Scripts for Complex Directory Logic
       ======================================================================== -->

  <!-- Point to external scripts that handle directory logic -->
  <DefineViteConfig 
      Name="script-based-build"
      CustomCommand="powershell -File &quot;$(MSBuildProjectDirectory)\scripts\build-with-directories.ps1&quot;"
      Mode="production" />

  <!-- Or shell script -->
  <DefineViteConfig 
      Name="shell-script-build"
      CustomCommand="bash &quot;$(MSBuildProjectDirectory)/scripts/build-with-directories.sh&quot;"
      Mode="production" />

  <!-- ========================================================================
       OPTION 6: Monorepo-Style Directory Management
       ======================================================================== -->

  <!-- Different configs for different workspace areas -->
  <DefineViteConfig 
      Name="admin-area"
      Config="Areas/Admin/vite.admin.config.ts"
      CustomCommand="powershell -Command &quot;cd Areas/Admin; npm run build:admin&quot;"
      OutputDir="wwwroot/admin"
      Mode="production" />

  <DefineViteConfig 
      Name="customer-area"
      Config="Areas/Customer/vite.customer.config.ts"
      CustomCommand="powershell -Command &quot;cd Areas/Customer; npm run build:customer&quot;"
      OutputDir="wwwroot/customer"
      Mode="production" />

  <!-- ========================================================================
       OPTION 7: Docker-Style Working Directories
       ======================================================================== -->

  <!-- Use Docker with working directory mount -->
  <DefineViteConfig 
      Name="docker-build"
      CustomCommand="docker run --rm -v &quot;$(MSBuildProjectDirectory):/app&quot; -w /app/frontend node:18 npm run build"
      Mode="production" />

  <!-- Docker Compose with specific service -->
  <DefineViteConfig 
      Name="compose-build"
      CustomCommand="docker-compose run --rm frontend npm run build"
      Mode="production" />

  <!-- ========================================================================
       OPTION 8: Direct MSBuild Property Usage (Recommended)
       ======================================================================== -->

  <!-- Use MSBuild properties directly in Config paths -->
  <DefineViteConfig 
      Name="solution-root-config"
      Config="$(SolutionRoot)/frontend/vite.config.ts"
      CustomCommand="npm run build"
      Mode="production" />

  <!-- Use project directory for relative paths -->
  <DefineViteConfig 
      Name="project-relative"
      Config="$(MSBuildProjectDirectory)/client-app/vite.config.ts"  
      CustomCommand="$(SolutionRoot)/build.sh"
      Mode="production" />

  <!-- Use custom properties for flexible paths -->
  <PropertyGroup>
    <ClientAppPath>$(SolutionRoot)/src/ClientApp</ClientAppPath>
    <SharedBuildScript>$(SolutionRoot)/scripts/shared-build.ps1</SharedBuildScript>
  </PropertyGroup>

  <DefineViteConfig 
      Name="flexible-paths"
      Config="$(ClientAppPath)/vite.config.ts"
      CustomCommand="$(SharedBuildScript) --target $(ClientAppPath)"
      Mode="production" />

  <!-- ========================================================================
       OPTION 9: Environment-Aware Paths
       ======================================================================== -->

  <!-- Different paths for different configurations -->
  <DefineViteConfig 
      Name="env-specific-build"
      Config="$(SolutionRoot)/apps/web/vite.config.ts"
      CustomCommand="$(SolutionRoot)/scripts/build-$(Configuration).sh"
      Mode="$(Configuration)"
      Condition="'$(Configuration)' == 'Development'" />

  <DefineViteConfig 
      Name="env-specific-build"
      Config="$(SolutionRoot)/apps/web/vite.config.ts"
      CustomCommand="$(SolutionRoot)/scripts/build-production.ps1"
      Mode="production"
      Condition="'$(Configuration)' == 'Release'" />

  <!-- ========================================================================
       OPTION 10: Team-Specific or User-Specific Paths
       ======================================================================== -->

  <!-- Allow developers to override paths -->
  <PropertyGroup>
    <DevScriptPath Condition="'$(DevScriptPath)' == ''">$(SolutionRoot)/scripts</DevScriptPath>
    <NodePath Condition="'$(NodePath)' == ''">node</NodePath>
  </PropertyGroup>

  <DefineViteConfig 
      Name="developer-customizable"
      Config="$(SolutionRoot)/web/vite.config.ts"
      CustomCommand="$(NodePath) $(DevScriptPath)/custom-build.js"
      Mode="development" />

  <ItemGroup>
    <PackageReference Include="Vite.MsBuild" Version="1.0.0" />
  </ItemGroup>

</Project>

