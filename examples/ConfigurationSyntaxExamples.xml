<!-- 
Vite.MsBuild Configuration Syntax Examples
Shows all supported ways to configure Vite builds in .csproj files
-->

<!-- ========================================================================
     OPTION 1: Traditional ItemGroup Style (Always Supported)
     ======================================================================== -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <!-- Traditional MSBuild ItemGroup approach -->
  <ItemGroup>
    <ViteConfig Include="Areas/Admin/vite.admin.config.ts">
      <BuildId>admin</BuildId>
      <Mode>development</Mode>
      <!-- OutputDir removed - will use smart Areas convention: wwwroot/Admin/ -->
    </ViteConfig>
    <ViteConfig Include="Areas/Customer/vite.customer.config.ts">
      <BuildId>customer</BuildId>
      <Mode>production</Mode>
      <!-- OutputDir removed - will use smart Areas convention: wwwroot/Customer/ -->
    </ViteConfig>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vite.MsBuild" Version="1.0.0" />
  </ItemGroup>
</Project>

<!-- ========================================================================
     OPTION 2: Task Style Configuration (.NET 6+ Enhanced)
     ======================================================================== -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Global defaults -->
    <VitePackageManager>pnpm</VitePackageManager>
    <ViteLogLevel>info</ViteLogLevel>
  </PropertyGroup>

  <!-- Clean task-style configuration -->
  <DefineViteConfig 
      Name="admin"
      Config="Areas/Admin/vite.admin.config.ts"
      OutputDir="wwwroot/admin"
      Mode="development"
      LogLevel="debug" />

  <DefineViteConfig 
      Name="customer"
      Config="Areas/Customer/vite.customer.config.ts"
      OutputDir="wwwroot/customer"
      Mode="production" />

  <ItemGroup>
    <PackageReference Include="Vite.MsBuild" Version="1.0.0" />
  </ItemGroup>
</Project>

<!-- ========================================================================
     OPTION 3: Namespaced Syntax (.NET 6+ Enhanced)
     ======================================================================== -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <!-- Explicit namespaced syntax - no conflicts with other MSBuild tasks -->
  <Vite.MsBuild.Tasks.NamespacedViteConfig 
      Name="admin"
      Config="Areas/Admin/vite.admin.config.ts"
      OutputDir="wwwroot/admin"
      Mode="development" />

  <Vite.MsBuild.Tasks.NamespacedViteConfig 
      Name="customer"
      Config="Areas/Customer/vite.customer.config.ts"
      OutputDir="wwwroot/customer"
      Mode="production" />

  <!-- Can also use namespaced build commands -->
  <Target Name="CustomViteBuild">
    <Vite.MsBuild.Tasks.NamespacedViteBuild 
        PackageManagerName="$(PackageManager)"
        ConfigPath="vite.config.ts"
        Mode="production"
        ValidateOnly="false">
      <Output TaskParameter="CommandLine" PropertyName="ViteCommand" />
    </Vite.MsBuild.Tasks.NamespacedViteBuild>
    
    <Message Text="Generated command: $(ViteCommand)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Vite.MsBuild" Version="1.0.0" />
  </ItemGroup>
</Project>

<!-- ========================================================================
     OPTION 4: XML Namespace Style (Most Professional)
     ======================================================================== -->
<Project Sdk="Microsoft.NET.Sdk.Web" 
         xmlns:vite="http://schemas.vite-msbuild.com/2024">
  
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <!-- XML namespace approach - cleanest syntax -->
  <vite:Config 
      Name="admin"
      Config="Areas/Admin/vite.admin.config.ts"
      OutputDir="wwwroot/admin"
      Mode="development" />

  <vite:Config 
      Name="customer"
      Config="Areas/Customer/vite.customer.config.ts"
      OutputDir="wwwroot/customer"
      Mode="production" />

  <!-- Custom build target with namespaced command -->
  <Target Name="CustomBuild">
    <vite:Build 
        PackageManager="pnpm"
        Config="vite.config.ts"
        Mode="production">
      <Output TaskParameter="CommandLine" PropertyName="BuildCommand" />
    </vite:Build>
    
    <Exec Command="$(BuildCommand)" WorkingDirectory="." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Vite.MsBuild" Version="1.0.0" />
  </ItemGroup>
</Project>

<!-- ========================================================================
     OPTION 5: Mixed Approach (Flexibility)
     ======================================================================== -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <!-- Mix traditional and modern syntax as needed -->
  
  <!-- Use ItemGroup for simple configs -->
  <ItemGroup>
    <ViteConfig Include="wwwroot/simple-app/vite.config.ts">
      <BuildId>simple</BuildId>
      <Mode>development</Mode>
    </ViteConfig>
  </ItemGroup>

  <!-- Use task style for complex configs -->
  <DefineViteConfig 
      Name="enterprise"
      Config="Areas/Enterprise/vite.enterprise.config.ts"
      OutputDir="wwwroot/enterprise"
      Mode="production"
      CustomCommand="yarn build:enterprise"
      LogLevel="warn"
      EnableColors="false" />

  <!-- Use namespaced syntax where explicit naming is important -->
  <Vite.MsBuild.Tasks.NamespacedViteConfig 
      Name="external-integration"
      Config="Integration/External/vite.external.config.ts"
      OutputDir="wwwroot/external"
      Mode="staging"
      PackageManager="bun" />

  <ItemGroup>
    <PackageReference Include="Vite.MsBuild" Version="1.0.0" />
  </ItemGroup>
</Project>

<!-- ========================================================================
     COMPARISON SUMMARY
     ======================================================================== -->
<!--
SYNTAX COMPARISON:

1. ItemGroup Style (Always Available):
   ✅ Works in all .NET versions
   ✅ Standard MSBuild pattern
   ❌ Verbose (5+ lines per config)
   ❌ Limited IntelliSense

2. Task Style (Enhanced):
   ✅ Concise (1 line per config)
   ✅ Full IntelliSense support
   ✅ Compile-time validation
   ⚡ Requires .NET 6+

3. Namespaced Syntax (Enterprise):
   ✅ No naming conflicts
   ✅ Explicit API surface
   ✅ Professional appearance
   ⚡ Requires .NET 6+

4. XML Namespace (Future):
   ✅ Cleanest syntax
   ✅ XML validation
   ✅ IDE support
   🚧 Requires additional setup

RECOMMENDATION:
- Start with ItemGroup for compatibility
- Upgrade to Task Style for better DX
- Use Namespaced for enterprise clarity
-->