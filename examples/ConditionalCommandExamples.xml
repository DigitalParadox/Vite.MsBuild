<!-- 
Cross-Platform Custom Command Examples
Shows how to use OS detection with Vite.MsBuild CustomCommand
-->

<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <!-- ========================================================================
       OPTION 1: MSBuild Conditional Properties (Recommended)
       ======================================================================== -->
  
  <!-- Define OS-specific build commands using MSBuild conditionals -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <CustomBuildCommand>powershell -Command "Write-Host 'Windows Build Starting'; npm run build:prod"</CustomBuildCommand>
    <CustomTestCommand>powershell -File .\scripts\run-tests.ps1</CustomTestCommand>
  </PropertyGroup>
  
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <CustomBuildCommand>sh -c "echo 'Linux Build Starting' &amp;&amp; npm run build:prod"</CustomBuildCommand>
    <CustomTestCommand>bash ./scripts/run-tests.sh</CustomTestCommand>
  </PropertyGroup>
  
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <CustomBuildCommand>sh -c "echo 'macOS Build Starting' &amp;&amp; npm run build:prod"</CustomBuildCommand>
    <CustomTestCommand>bash ./scripts/run-tests.sh</CustomTestCommand>
  </PropertyGroup>

  <!-- Use the conditional command -->
  <DefineViteConfig 
      Name="production"
      Config="vite.config.ts"
      CustomCommand="$(CustomBuildCommand)"
      Mode="production" />

  <!-- ========================================================================
       OPTION 2: Multiple Configs with Conditions
       ======================================================================== -->

  <!-- Windows-specific config -->
  <DefineViteConfig 
      Name="windows-build"
      Config="vite.config.ts"
      CustomCommand="powershell -Command &quot;.\scripts\windows-build.ps1&quot;"
      Mode="production"
      Condition="$([MSBuild]::IsOSPlatform('Windows'))" />

  <!-- Linux/macOS config -->
  <DefineViteConfig 
      Name="unix-build"
      Config="vite.config.ts"
      CustomCommand="bash ./scripts/unix-build.sh"
      Mode="production"
      Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />

  <!-- ========================================================================
       OPTION 3: Advanced Environment Detection
       ======================================================================== -->

  <PropertyGroup>
    <!-- Detect if running in CI/CD -->
    <IsCI Condition="'$(CI)' == 'true' OR '$(GITHUB_ACTIONS)' == 'true' OR '$(AZURE_PIPELINES)' == 'true'">true</IsCI>
    
    <!-- Detect PowerShell Core vs Windows PowerShell -->
    <IsPowerShellCore Condition="'$(PSVersionTable.PSEdition)' == 'Core'">true</IsPowerShellCore>
  </PropertyGroup>

  <!-- CI-specific builds -->
  <DefineViteConfig 
      Name="ci-build"
      Config="vite.config.ts"
      CustomCommand="npm ci &amp;&amp; npm run build:ci"
      Mode="production"
      Condition="'$(IsCI)' == 'true'" />

  <!-- Development builds with live reload -->
  <DefineViteConfig 
      Name="dev-watch"
      Config="vite.config.ts"
      CustomCommand="npm run dev -- --host"
      Mode="development"
      Condition="'$(IsCI)' != 'true'" />

  <!-- ========================================================================
       OPTION 4: Complex Conditional Logic
       ======================================================================== -->

  <!-- Define script paths based on OS -->
  <PropertyGroup>
    <ScriptExtension Condition="$([MSBuild]::IsOSPlatform('Windows'))">.ps1</ScriptExtension>
    <ScriptExtension Condition="!$([MSBuild]::IsOSPlatform('Windows'))">.sh</ScriptExtension>
    
    <ScriptRunner Condition="$([MSBuild]::IsOSPlatform('Windows'))">powershell -File</ScriptRunner>
    <ScriptRunner Condition="!$([MSBuild]::IsOSPlatform('Windows'))">bash</ScriptRunner>
  </PropertyGroup>

  <!-- Use computed script paths -->
  <DefineViteConfig 
      Name="cross-platform-build"
      Config="vite.config.ts"
      CustomCommand="$(ScriptRunner) ./scripts/build$(ScriptExtension)"
      Mode="production" />

  <ItemGroup>
    <PackageReference Include="Vite.MsBuild" Version="1.0.0" />
  </ItemGroup>

</Project>

<!-- ========================================================================
     OPTION 5: PowerShell with OS Detection (Advanced)
     ======================================================================== -->
<!--
You could also embed OS detection directly in PowerShell:

<DefineViteConfig 
    Name="smart-build"
    CustomCommand="powershell -Command &quot;if ($IsWindows) { .\scripts\windows-build.ps1 } elseif ($IsLinux) { bash ./scripts/linux-build.sh } else { bash ./scripts/macos-build.sh }&quot;"
    Mode="production" />
-->

<!-- ========================================================================
     MSBuild OS Detection Reference
     ======================================================================== -->
<!--
Available MSBuild OS detection functions:

$([MSBuild]::IsOSPlatform('Windows'))   - True on Windows
$([MSBuild]::IsOSPlatform('Linux'))     - True on Linux  
$([MSBuild]::IsOSPlatform('OSX'))       - True on macOS
$([MSBuild]::IsOSPlatform('FreeBSD'))   - True on FreeBSD

Environment variables you can check:
- $(OS) - Windows_NT on Windows
- $(OSTYPE) - Linux shell type info
- $(CI), $(GITHUB_ACTIONS), etc. - CI/CD detection

Example usage in conditions:
Condition="'$(OS)' == 'Windows_NT'"
Condition="$([MSBuild]::IsOSPlatform('Windows')) AND '$(Configuration)' == 'Release'"
-->