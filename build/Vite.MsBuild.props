<Project>

    <!-- 
    Vite.MsBuild | MSBuild Integration for Vite
    
    Framework-agnostic MSBuild integration for Vite in ASP.NET Core projects.
    Supports: Vue, React, Svelte, Solid, Preact, and vanilla JS/TS
    
    Quick Start
    ===========
    
    Install via NuGet:
      dotnet add package Vite.MsBuild
    
    The package auto-enables when installed. To disable:
      <EnableViteBuild>false</EnableViteBuild>
    
    Configuration (Optional)
    ========================
    
    <PropertyGroup>
      (Optional) Custom Vite config location (defaults to auto-detect)
      <ViteConfigFile>$(MSBuildProjectDirectory)\custom-vite.config.ts</ViteConfigFile>
      
      (Optional) Custom output directory (defaults to wwwroot\dist)
      <ViteOutputDir>wwwroot\assets</ViteOutputDir>
      
      (Optional) Override Vite mode
      <ViteMode>staging</ViteMode>
      
      (Optional) Force specific package manager (auto-detects by default)
      <PackageManager>pnpm</PackageManager>  (npm, pnpm, yarn, or bun)
      
      (Optional) Action when multiple lock files detected (default: warn)
      <VitePackageManagerConflictAction>warn</VitePackageManagerConflictAction>  (warn, error)
      
      (Optional) Validate .env files exist (default: silent)
      <ViteMissingEnvAction>warn</ViteMissingEnvAction>  (silent, warn, or error)
      
      (Optional) Enable/disable ANSI colors in Vite output (default: true)
      <ViteEnableColors>false</ViteEnableColors>  (useful for CI/CD)
      
      (Optional) Use npx/dlx fallback when Vite not in package.json (default: false)
      <ViteUseDlxFallback>true</ViteUseDlxFallback>  (useful for testing without local installs)
      
      (Optional) Specify which package.json script to run (default: build)
      <ViteBuildScript>build:production</ViteBuildScript>  (build, build:prod, dev, etc.)
      Set to empty string to force direct vite CLI calls
      
      (Optional) Force direct vite build calls, bypass package.json scripts (default: false)
      <DirectViteBuild>true</DirectViteBuild>  (gives full control over Vite CLI flags)
      
      (Optional) When to run Vite build relative to C# compilation (default: BeforeCSharp)
      <ViteBuildTiming>AfterCSharp</ViteBuildTiming>  (BeforeCSharp or AfterCSharp)
      
      (Optional) Add frontend files to dotnet watch (default: false)
      <ViteWatchIntegration>true</ViteWatchIntegration>
    </PropertyGroup>
    
    Multi-SPA Configuration (Advanced)
    ==================================
    
    For multiple SPAs in a single project (enterprise scenarios):
    
    <ItemGroup>
      <ViteConfigs Include="Areas\Admin\vite.config.admin.ts">
        <BuildId>admin</BuildId>
        <OutputDir>wwwroot\admin</OutputDir>
        <Mode>development</Mode>
      </ViteConfigs>
      
      <ViteConfigs Include="Areas\Customer\vite.config.customer.ts">
        <BuildId>customer</BuildId>
        <OutputDir>wwwroot\customer</OutputDir>
        <Mode>production</Mode>
      </ViteConfigs>
      
      <ViteConfigs Include="Areas\Partner\vite.config.partner.ts">
        <BuildId>partner</BuildId>
        <OutputDir>wwwroot\partner</OutputDir>
        <Mode>development</Mode>
      </ViteConfigs>
    </ItemGroup>
    
    Multi-SPA Features:
    - Independent tech stacks (Vue + React + Angular)
    - Separate build optimization per SPA
    - Incremental builds (only changed SPAs rebuild)
    - Per-SPA marker files for build state tracking
    
    Customizing Tracked Files
    ==========================
    Add or remove files from incremental build tracking:
    
    <ItemGroup>
      <ViteInputFiles Include="wwwroot\custom\**\*.ts" />
      <ViteInputFiles Remove="wwwroot\js\legacy\**\*" />
    </ItemGroup>
    
    Documentation
    =============
    https://github.com/DigitalParadox/Vite.MsBuild#readme
  -->

    <!-- ====================================================================== -->
    <!-- Vite Frontend Integration Properties                                   -->
    <!-- ====================================================================== -->

    <PropertyGroup Label="Vite Configuration">
        <!-- 
        Property Naming: All properties are prefixed with "Vite" for namespace safety
        Examples: EnableViteBuild, ViteProjectRoot, ViteOutputDir, ViteMode, etc.
        -->

        <!-- Detect if loaded from NuGet package vs Directory.Build.props -->
        <!-- NuGet packages are in .nuget/packages/ path -->
        <_ViteLoadedFromPackage Condition="$(MSBuildThisFileFullPath.Contains('.nuget')) OR $(MSBuildThisFileFullPath.Contains('packages\Vite.MsBuild'))">true</_ViteLoadedFromPackage>
        <_ViteLoadedFromPackage Condition="'$(_ViteLoadedFromPackage)' == ''">false</_ViteLoadedFromPackage>
        
        <!-- EnableViteBuild: Auto-enable if loaded from NuGet package, opt-in if Directory.Build.props -->
        <EnableViteBuild Condition="'$(EnableViteBuild)' == '' AND '$(_ViteLoadedFromPackage)' == 'true'">true</EnableViteBuild>
        <EnableViteBuild Condition="'$(EnableViteBuild)' == ''">false</EnableViteBuild>

        <!-- ViteProjectRoot: Check project directory first, then fall back to repo root -->
        <!-- This supports both project-specific and repo-wide Vite configurations -->
        <ViteProjectRoot Condition="'$(ViteProjectRoot)' == '' AND Exists('$(MSBuildProjectDirectory)\package.json')">$(MSBuildProjectDirectory)\</ViteProjectRoot>
        <ViteProjectRoot Condition="'$(ViteProjectRoot)' == ''">$(MSBuildThisFileDirectory)</ViteProjectRoot>

        <!-- ViteOutputDir -->
        <ViteOutputDir Condition="'$(ViteOutputDir)' == ''">wwwroot\dist</ViteOutputDir>

        <!-- ViteOutputPath (computed) -->
        <ViteOutputPath>$(MSBuildProjectDirectory)\$(ViteOutputDir)</ViteOutputPath>

        <!-- Multi-Config Support Detection -->
        <!-- We'll detect this in the targets file where ItemGroups are available -->
        <ViteMultiConfigMode Condition="'$(ViteMultiConfigMode)' == ''">false</ViteMultiConfigMode>

        <!-- ViteConfigFile: Check project directory first, then fall back to ViteProjectRoot -->
        <!-- Auto-detection for single config mode (will be overridden in multi-config mode) -->
        <ViteConfigFile Condition="'$(ViteConfigFile)' == '' AND Exists('$(MSBuildProjectDirectory)\vite.config.ts')">$(MSBuildProjectDirectory)\vite.config.ts</ViteConfigFile>
        <ViteConfigFile Condition="'$(ViteConfigFile)' == '' AND Exists('$(MSBuildProjectDirectory)\vite.config.js')">$(MSBuildProjectDirectory)\vite.config.js</ViteConfigFile>
        <ViteConfigFile Condition="'$(ViteConfigFile)' == '' AND Exists('$(MSBuildProjectDirectory)\vite.config.mjs')">$(MSBuildProjectDirectory)\vite.config.mjs</ViteConfigFile>
        <ViteConfigFile Condition="'$(ViteConfigFile)' == '' AND Exists('$(ViteProjectRoot)vite.config.ts')">$(ViteProjectRoot)vite.config.ts</ViteConfigFile>
        <ViteConfigFile Condition="'$(ViteConfigFile)' == '' AND Exists('$(ViteProjectRoot)vite.config.js')">$(ViteProjectRoot)vite.config.js</ViteConfigFile>
        <ViteConfigFile Condition="'$(ViteConfigFile)' == '' AND Exists('$(ViteProjectRoot)vite.config.mjs')">$(ViteProjectRoot)vite.config.mjs</ViteConfigFile>
        <ViteConfigFile Condition="'$(ViteConfigFile)' == ''">$(ViteProjectRoot)vite.config.ts</ViteConfigFile>

        <!-- PackageManager -->
        <PackageManager Condition="'$(PackageManager)' == '' AND Exists('$(ViteProjectRoot)bun.lockb')">bun</PackageManager>
        <PackageManager Condition="'$(PackageManager)' == '' AND Exists('$(ViteProjectRoot)pnpm-lock.yaml')">pnpm</PackageManager>
        <PackageManager Condition="'$(PackageManager)' == '' AND Exists('$(ViteProjectRoot)yarn.lock')">yarn</PackageManager>
        <PackageManager Condition="'$(PackageManager)' == '' AND Exists('$(ViteProjectRoot)package-lock.json')">npm</PackageManager>
        <PackageManager Condition="'$(PackageManager)' == ''">npm</PackageManager>

        <!-- Install commands per package manager -->
        <ViteInstallCommand Condition="'$(PackageManager)' == 'bun'">bun install --frozen-lockfile</ViteInstallCommand>
        <ViteInstallCommand Condition="'$(PackageManager)' == 'pnpm'">pnpm install --frozen-lockfile</ViteInstallCommand>
        <ViteInstallCommand Condition="'$(PackageManager)' == 'yarn'">yarn install --frozen-lockfile</ViteInstallCommand>
        <ViteInstallCommand Condition="'$(PackageManager)' == 'npm'">npm ci</ViteInstallCommand>

        <!-- ViteMode: Will be resolved in ResolveViteMode target (Configuration might not be set yet) -->

        <!-- Map MSBuild verbosity to Vite log level -->
        <ViteLogLevel Condition="'$(MSBuildVerbosity)' == 'quiet'">silent</ViteLogLevel>
        <ViteLogLevel Condition="'$(MSBuildVerbosity)' == 'minimal'">warn</ViteLogLevel>
        <ViteLogLevel Condition="'$(MSBuildVerbosity)' == 'normal'">info</ViteLogLevel>
        <ViteLogLevel Condition="'$(MSBuildVerbosity)' == 'detailed'">info</ViteLogLevel>
        <ViteLogLevel Condition="'$(MSBuildVerbosity)' == 'diagnostic'">debug</ViteLogLevel>
        <ViteLogLevel Condition="'$(ViteLogLevel)' == ''">info</ViteLogLevel>

        <!-- ViteMissingEnvAction - optional validation for .env files -->
        <ViteMissingEnvAction Condition="'$(ViteMissingEnvAction)' == ''">silent</ViteMissingEnvAction>

        <!-- VitePackageManagerConflictAction - behavior for multiple lock files -->
        <VitePackageManagerConflictAction Condition="'$(VitePackageManagerConflictAction)' == ''">warn</VitePackageManagerConflictAction>
        <VitePackageManagerConflictAction Condition="'$(CI)' == 'true' AND '$(VitePackageManagerConflictAction)' == 'warn'">error</VitePackageManagerConflictAction>

        <!-- ViteEnableColors - enable ANSI color codes in Vite output (default: true) -->
        <ViteEnableColors Condition="'$(ViteEnableColors)' == ''">true</ViteEnableColors>

        <!-- ViteUseDlxFallback - use npx/pnpm dlx/yarn dlx/bun x when Vite not in package.json (default: false) -->
        <ViteUseDlxFallback Condition="'$(ViteUseDlxFallback)' == ''">false</ViteUseDlxFallback>

        <!-- ViteBuildCommand - custom build command override (highest priority) -->
        <!-- Example: <ViteBuildCommand>npm run build:prod</ViteBuildCommand> -->
        <!-- Leave empty to use automatic package manager detection -->
        <ViteBuildCommand Condition="'$(ViteBuildCommand)' == ''"></ViteBuildCommand>

        <!-- ViteBuildScript - specify which package.json script to run (default: "build") -->
        <!-- Examples: "build:production", "build:staging", "build:dev" -->
        <!-- Set to empty to force direct vite build calls even if scripts exist -->
        <!-- Future: Will support "dev" for dev server pass-through -->
        <ViteBuildScript Condition="'$(ViteBuildScript)' == ''">build</ViteBuildScript>

        <!-- DirectViteBuild - force direct vite CLI calls, bypass package.json scripts -->
        <!-- Set to 'true' to use 'npx vite build' even if package.json has build script -->
        <!-- Useful when you want MSBuild to control all Vite CLI flags -->
        <DirectViteBuild Condition="'$(DirectViteBuild)' == ''">false</DirectViteBuild>

        <!-- ViteCommandType - DEPRECATED: Use DirectViteBuild or ViteBuildScript instead -->
        <!-- Kept for backward compatibility, will be removed in future version -->
        <ViteCommandType Condition="'$(ViteCommandType)' == ''"></ViteCommandType>

        <!-- ViteBuildTiming - when to run Vite build relative to C# compilation -->
        <!-- Options: 'BeforeCSharp' (default) or 'AfterCSharp' -->
        <ViteBuildTiming Condition="'$(ViteBuildTiming)' == ''">BeforeCSharp</ViteBuildTiming>

        <!-- ViteEnableDiagnostics - enable diagnostic logging (default: false) -->
        <!-- Auto-enables in CI when debug mode is enabled (RUNNER_DEBUG, SYSTEM_DEBUG, etc.) -->
        <!-- Set to 'true' to explicitly enable, 'false' to disable even in CI debug mode -->
        <ViteEnableDiagnostics Condition="'$(ViteEnableDiagnostics)' == ''">false</ViteEnableDiagnostics>

        <!-- ViteDiagnosticLogPath - custom diagnostic log location (optional) -->
        <!-- Defaults to %LOCALAPPDATA%\ViteKit.MsBuild\diagnostics\ on local builds -->
        <!-- Defaults to CI artifact paths in CI environments -->
        <ViteDiagnosticLogPath Condition="'$(ViteDiagnosticLogPath)' == ''">$(LOCALAPPDATA)\ViteKit.MsBuild\diagnostics</ViteDiagnosticLogPath>

        <!-- Marker files - Microsoft SDK pattern: Always in IntermediateOutputPath (obj/) -->
        <!-- Vite build marker - tracks successful Vite builds per target framework -->
        <ViteBuildMarker>$(IntermediateOutputPath)$(TargetFramework).Vite.MsBuild.Build.marker</ViteBuildMarker>

        <!-- Node restore marker - tracks successful npm/pnpm/yarn/bun install -->
        <NodeRestoreMarker>$(ViteProjectRoot)obj\Vite.MsBuild.NodeRestore.marker</NodeRestoreMarker>

        <!-- Working directory - use repo root where package.json and node_modules are located -->
        <ViteWorkingDirectory>$(ViteProjectRoot)</ViteWorkingDirectory>
    </PropertyGroup>

    <!-- ====================================================================== -->
    <!-- dotnet watch Integration                                               -->
    <!-- ====================================================================== -->

    <ItemGroup Condition="'$(EnableViteBuild)' == 'true' AND '$(ViteWatchIntegration)' == 'true'">
        <!-- Watch TypeScript/JavaScript files -->
        <Watch Include="wwwroot\js\**\*.ts" />
        <Watch Include="wwwroot\js\**\*.tsx" />
        <Watch Include="wwwroot\js\**\*.js" />
        <Watch Include="wwwroot\js\**\*.jsx" />
        <Watch Include="wwwroot\js\**\*.mts" />
        <Watch Include="wwwroot\js\**\*.mjs" />

        <!-- Watch framework component files -->
        <Watch Include="wwwroot\js\**\*.vue" />
        <Watch Include="wwwroot\js\**\*.svelte" />

        <!-- Watch CSS/Style files -->
        <Watch Include="wwwroot\css\**\*.css" />
        <Watch Include="wwwroot\css\**\*.scss" />
        <Watch Include="wwwroot\css\**\*.sass" />
        <Watch Include="wwwroot\css\**\*.less" />
        <Watch Include="wwwroot\css\**\*.styl" />
        <Watch Include="wwwroot\css\**\*.stylus" />
        <Watch Include="wwwroot\css\**\*.pcss" />

        <!-- Watch Vite configuration -->
        <Watch Include="$(ViteConfigFile)" />
        <Watch Include="$(ViteProjectRoot)postcss.config.*" />
        <Watch Include="$(ViteProjectRoot)tailwind.config.*" />
        <Watch Include="$(ViteProjectRoot)tsconfig.json" />
    </ItemGroup>

    <!-- ====================================================================== -->
    <!-- Publishing Integration                                                 -->
    <!-- ====================================================================== -->

    <ItemGroup Label="Vite Assets for Publishing" Condition="'$(EnableViteBuild)' == 'true'">
        <Content Update="$(ViteOutputDir)\**\*"
            CopyToPublishDirectory="Always"
            Condition="Exists('$(ViteOutputPath)')" />
    </ItemGroup>

</Project>
