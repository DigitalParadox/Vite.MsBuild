<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target for broad MSBuild compatibility + 2026 preview support -->
    <TargetFrameworks>netstandard2.0;net6.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    
    <!-- Suppress acceptable MSBuild security warnings (build-time only, not runtime) -->
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
    
    <!-- Package info -->
    <PackageId>Vite.MsBuild.Tasks</PackageId>
    <Version>1.0.0</Version>
    <Description>MSBuild tasks for Vite.MsBuild integration</Description>
    <Company>Vite.MsBuild</Company>
    
    <!-- Don't include in main package - this is internal -->
    <IncludeInPackage>false</IncludeInPackage>
  </PropertyGroup>

  <!-- Conditional nullable support -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net6.0' OR '$(TargetFramework)' == 'net8.0' OR '$(TargetFramework)' == 'net9.0' OR '$(TargetFramework)' == 'net10.0'">
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Nullable>disable</Nullable>
    <!-- Suppress nullable reference type warnings for .NET Standard 2.0 compatibility -->
    <NoWarn>$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>

  <!-- MSBuild references based on target framework - Updated for security -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- MSBuild 16.x for .NET Core 3.1+ / .NET 5+ - Visual Studio 2019+ -->
    <!-- Updated to latest 16.x without known vulnerabilities -->
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="16.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="16.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0' OR '$(TargetFramework)' == 'net8.0'">
    <!-- MSBuild 17.x for .NET 6+ / .NET 8+ - Visual Studio 2022 -->
    <!-- Updated to latest patch version for security -->
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="17.11.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.11.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0' OR '$(TargetFramework)' == 'net10.0'">
    <!-- MSBuild 18.x+ for .NET 9+ / .NET 10+ (2026 preview) - Visual Studio 2025+ -->
    <!-- Using latest available version for preview frameworks -->
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="17.11.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.11.4" PrivateAssets="all" />
  </ItemGroup>

  <!-- Polyfills for older frameworks - Updated for security -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- Updated to latest secure versions -->
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="IsExternalInit" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Nullable" Version="1.3.1" PrivateAssets="all" />
  </ItemGroup>

</Project>