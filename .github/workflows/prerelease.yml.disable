name: Prerelease

on:
  push:
    tags:
      - 'v*'

permissions:
  contents: write
  packages: write
  checks: write

jobs:
  build:
    name: Build, Test, and Report (${{ matrix.os }})
    if: contains(github.ref_name, '-')
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest, macos-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Build and Test
        id: build
        uses: ./.github/actions/build-and-test

      - name: Publish unit test results
        uses: dorny/test-reporter@v1
        if: always()
        with:
          name: Unit Test Results (${{ matrix.os }})
          path: "${{ steps.build.outputs.test-results }}/**/*.trx"
          reporter: dotnet-trx

      - name: Upload test results artifact
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: unit-test-results-${{ matrix.os }}
          path: ${{ steps.build.outputs.test-results }}
          retention-days: 14

      - name: Upload coverage artifact
        uses: actions/upload-artifact@v4
        if: always() && matrix.os == 'ubuntu-latest'
        with:
          name: coverage-report
          path: ${{ steps.build.outputs.coverage-report }}
          retention-days: 14

      - name: Publish coverage summary
        uses: ./.github/actions/publish-github-check
        if: always() && matrix.os == 'ubuntu-latest'
        with:
          check-name: Coverage Summary
          title: Coverage Summary
          summary-file: ${{ steps.build.outputs.coverage-report }}/SummaryGithub.md
          summary: Coverage summary not available.

  publish:
    name: Pack, Push, and Publish Prerelease
    runs-on: ubuntu-latest
    needs: build
    if: contains(github.ref_name, '-')
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Determine release version
        id: version
        shell: bash
        run: |
          tag="${GITHUB_REF#refs/tags/}"
          version="${tag#v}"
          echo "version=$version" >> "$GITHUB_OUTPUT"

      - name: Generate release notes
        id: release_notes
        uses: ./.github/actions/generate-release-notes
        with:
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Upload release notes artifact
        uses: actions/upload-artifact@v4
        with:
          name: release-notes
          path: ${{ steps.release_notes.outputs.notes_path }}
          retention-days: 14

      - name: Pack and publish NuGet packages
        id: pack
        uses: ./.github/actions/pack-and-push-nuget
        with:
          version: ${{ steps.version.outputs.version }}
          push-to-nuget: 'true'
          nuget-api-key: ${{ secrets.NUGET_API_KEY }}
          push-to-github: 'true'
          github-token: ${{ secrets.GITHUB_TOKEN }}
          release-notes: ${{ steps.release_notes.outputs.notes_content }}
          release-notes-file: ${{ steps.release_notes.outputs.notes_path }}

      - name: Publish GitHub prerelease
        uses: ./.github/actions/github-release
        with:
          tag: ${{ github.ref_name }}
          name: Pre-release ${{ steps.version.outputs.version }}
          release_notes_path: ${{ steps.release_notes.outputs.notes_path }}
          release_notes_content: ${{ steps.release_notes.outputs.notes_content }}
          prerelease: 'true'
          files: "${{ steps.pack.outputs.package-directory }}/*.nupkg"
